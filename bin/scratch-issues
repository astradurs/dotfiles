#!/bin/zsh
# List the open issues in ./.scratch, grouped by project, with their status.
#
#   scratch-issues            open issues only
#   scratch-issues -a         include closed ones (done, resolved, wontfix, closed)
#   scratch-issues <p>        open the spec of project [p] from the last listing in glow
#   scratch-issues <p> <i>    open issue <i> (its file number, e.g. 3 for 03-*.md) of project [p]
#   scratch-issues next [<p>] open the first unblocked ready-for-agent issue, in ./.scratch or
#                             in project [p]
#
# Add -e to any form that opens a file to open it in $VISUAL / $EDITOR instead of glow.
#
# Like scm_breeze, each project gets a [p] that stays valid until the next listing, from any
# directory: the listing saves the numbered project paths to $index. `--complete [<p>]` prints
# completion candidates for the zsh completion in .zshrc.
#
# Expects the ai-hero layout: .scratch/<project>/{spec.md,issues/<NN>-<name>.md}, where each
# issue has a "Status: <status>" line and optionally a "Blocked by: <ids>" line.
#
# Without a .scratch directory, it lists the GitHub issues of the origin remote instead, with a
# triage label (ready-for-agent, needs-info, ...) as the status. That listing is numbered by issue
# number: `scratch-issues <n>` opens issue #n with gh (in the browser with -e), and `next` opens the
# lowest-numbered open ready-for-agent issue.
emulate -L zsh
setopt extended_glob

index=${XDG_CACHE_HOME:-$HOME/.cache}/scratch-issues
closed=(done resolved wontfix closed)
usage="usage: scratch-issues [-a] | [-e] (<p> [<i>] | next [<p>])"

# Value of the first "<Key>: value" or "**<Key>:** value" line in a file, or empty.
field() { grep -m1 -iE "^(\*\*)?$1:" $2 | sed -E 's/^[^:]*:(\*\*)?[[:space:]]*//' }

# Read every issue of project dir $1 into parallel arrays: issue_files, issue_status (as written),
# issue_key ("needs-info — waiting on X" → "needs-info"), issue_title, and issue_blockers (the
# "Blocked by" issues that are still open, ", "-joined).
scan() {
  issue_files=($1/issues/*.md(N))
  issue_status=() issue_key=() issue_title=() issue_blockers=()
  local issue s name num title blocked_by blocker
  local -a open
  local -A key_by_num
  for issue in $issue_files; do
    s=${$(field Status $issue):-unknown}
    issue_status+=("$s")
    issue_key+=("${${s:l}%%[^a-z-]*}")
    key_by_num[$(( 10#${${issue:t}%%-*} ))]=$issue_key[-1]
  done
  for issue in $issue_files; do
    name=${issue:t:r}
    num=${name%%-*}
    title=$(sed -n '1s/^#[[:space:]]*//p' $issue)
    # Drop the "05 — " prefix the heading repeats from the filename.
    issue_title+=("${${title:-${name#*-}}##${num}[[:space:]]#[—–:-]#[[:space:]]#}")
    blocked_by=$(field 'Blocked by' $issue)
    open=()
    for blocker in ${(M)${(s:,:)${blocked_by//[^0-9]/,}}:#[0-9]##}; do
      (( ${closed[(Ie)${key_by_num[$(( 10#$blocker ))]}]} )) || open+=$blocker
    done
    issue_blockers+=("${(j:, :)open}")
  done
}

# OWNER/REPO of the origin remote, prefixed with HOST/ when it isn't github.com.
origin_repo() {
  local url host repo
  url=$(git remote get-url origin 2>/dev/null) || return 1
  if [[ $url == *://* ]]; then  # https://host/o/r, ssh://git@host:22/o/r
    url=${${url#*://}#*@} host=${${url%%/*}%%:*} repo=${url#*/}
  elif [[ $url == *:* ]]; then  # git@host:o/r
    url=${url#*@} host=${url%%:*} repo=${url#*:}
  else
    return 1
  fi
  repo=${${repo%/}%.git}
  [[ $repo == */* ]] || return 1
  print -r -- ${${host:#github.com}:+$host/}$repo
}

# The last listing, one entry per line: project dirs, or "github:<repo>" then "<n>:<title>" lines.
# Sets gh_repo when it was a GitHub listing.
last_listing() {
  [[ -f $index ]] || { print -u2 "no listing yet; run scratch-issues first"; exit 1 }
  listing=(${(f)"$(<$index)"})
  gh_repo=
  [[ ${listing[1]:-} == github:* ]] && gh_repo=${listing[1]#github:}
}

# Project dir [$1] of the last listing.
project_at() {
  last_listing
  [[ -z $gh_repo ]] || { print -u2 "the last listing was GitHub issues for $gh_repo; run scratch-issues in a .scratch repo first"; exit 1 }
  local -a projects=($listing)
  project=${projects[$1]}
  [[ -n $project ]] || { print -u2 "no project [$1] in the last listing ($#projects projects)"; exit 1 }
  [[ -d $project ]] || { print -u2 "$project no longer exists"; exit 1 }
}

open_file() {
  if (( edit )); then exec ${=${VISUAL:-${EDITOR:-vim}}} ${1:a}
  elif (( $+commands[glow] )); then exec glow -p ${1:a}
  else exec ${PAGER:-less} ${1:a}
  fi
}

open_github() {
  if (( edit )); then exec gh issue view $1 -R $gh_repo --web
  else exec gh issue view $1 -R $gh_repo
  fi
}

# Repo of the origin remote into gh_repo, for when there's no .scratch here; otherwise exits with
# status $1.
need_github() {
  gh_repo=$(origin_repo) || { print -u2 "no .scratch directory or origin remote here"; exit $1 }
  (( $+commands[gh] )) || { print -u2 "no .scratch directory, and gh isn't installed to read $gh_repo issues"; exit $1 }
  [[ $gh_repo != */*/* ]] || gh auth status -h ${gh_repo%%/*} &>/dev/null ||
    { print -u2 "no .scratch directory, and origin (${gh_repo%%/*}) isn't a GitHub host gh is logged in to"; exit $1 }
}

if [[ ${1:-} == --complete ]]; then
  [[ -f $index ]] && last_listing
  if [[ -n $gh_repo ]]; then
    [[ -n ${2:-} ]] || print -l -- $listing[2,-1]
  elif [[ ${2:-} == <1-> ]]; then
    project_at $2 2>/dev/null
    scan $project
    for (( i = 1; i <= $#issue_files; i++ )); do
      print -r -- "$(( 10#${${issue_files[i]:t}%%-*} )):$issue_title[i] [$issue_key[i]]"
    done
  elif [[ -f $index ]]; then
    i=0
    for project in ${(f)"$(<$index)"}; do print -r -- "$(( ++i )):${project:t}"; done
  fi
  exit 0
fi

show_all=0 edit=0 args=()
for arg; do
  case $arg in
    -a|--all) show_all=1 ;;
    -e|--edit) edit=1 ;;
    -*) print -u2 $usage; exit 2 ;;
    *) args+=$arg ;;
  esac
done

if [[ ${args[1]:-} == next ]]; then
  if (( $#args == 2 )) && [[ $args[2] == <1-> ]]; then
    project_at $args[2]
    candidates=($project)
  elif (( $#args == 1 )); then
    if [[ ! -d .scratch ]]; then
      need_github 1
      next=$(gh issue list -R $gh_repo -l ready-for-agent -L 200 --json number,title \
        -q 'sort_by(.number) | .[0] // empty | "\(.number)\t\(.title)"') || exit 1
      [[ -n $next ]] || { print -u2 "no ready-for-agent issue in $gh_repo"; exit 1 }
      print -r -- "$gh_repo #${next%%$'\t'*}: ${next#*$'\t'}"
      open_github ${next%%$'\t'*}
    fi
    candidates=(.scratch/*(N/))
  else
    print -u2 $usage; exit 2
  fi
  for project in $candidates; do
    scan $project
    for (( i = 1; i <= $#issue_files; i++ )); do
      [[ $issue_key[i] == ready-for-agent && -z $issue_blockers[i] ]] || continue
      print -r -- "${project:t} ${issue_files[i]:t:r}: $issue_title[i]"
      open_file $issue_files[i]
    done
  done
  print -u2 "no unblocked ready-for-agent issue"
  exit 1
fi

if (( $#args )); then
  [[ $#args -le 2 && $args[1] == <1-> && ${args[2]:-1} == <1-> ]] || { print -u2 $usage; exit 2 }
  last_listing
  if [[ -n $gh_repo ]]; then
    (( $#args == 1 )) || { print -u2 "the last listing was GitHub issues for $gh_repo; use: scratch-issues <n>"; exit 2 }
    open_github $args[1]
  fi
  project_at $args[1]
  if (( $#args == 2 )); then
    # Any zero-padding: 3, 03 and 003 all open 03-*.md.
    matches=($project/issues/(0#)$(( 10#$args[2] ))-*.md(N))
    (( $#matches )) || { print -u2 "no issue $args[2] in ${project:t}"; exit 1 }
    open_file $matches[1]
  fi
  [[ -f $project/spec.md ]] || { print -u2 "${project:t} has no spec.md; open an issue with: scratch-issues $args[1] <i>"; exit 1 }
  open_file $project/spec.md
fi

if [[ -t 1 ]]; then
  bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m'
  typeset -A colour=(
    ready-for-agent $'\e[32m' ready-for-human $'\e[33m' needs-info $'\e[35m'
    needs-triage $'\e[36m' in-progress $'\e[34m' unknown $'\e[31m'
  )
else
  bold= dim= reset=
  typeset -A colour
fi

summarise() {
  local key summary=()
  for key in ${(ok)counts}; do summary+="${colour[$key]}${key}${reset} ${counts[$key]}"; done
  print "\n${(j:, :)summary}"
}

if [[ ! -d .scratch ]]; then
  need_github 0
  (( show_all )) && state=all || state=open
  issues=$(gh issue list -R $gh_repo -s $state -L 200 --json number,state,labels,title \
    -q '.[] | [.number, .state, ([.labels[].name] | join(",")), .title] | @tsv') || exit 1
  typeset -A counts
  entries=() out=()
  # gh lists newest first, so the first issue has the widest number.
  width=$(( ${#${issues%%$'\t'*}} + 1 ))
  while IFS=$'\t' read -r num gh_state labels title; do
    [[ -n $num ]] || continue
    labels=(${(s:,:)labels})
    # A triage label stands in for the status of an open issue; closed ones are just closed.
    key=${gh_state:l}
    if [[ $key == open ]]; then
      for label in $labels; do
        (( $+colour[$label] )) || [[ $label == (needs-*|ready-for-*|in-progress|blocked) ]] || continue
        key=$label; labels=(${labels:#$label}); break
      done
    fi
    counts[$key]=$(( ${counts[$key]:-0} + 1 ))
    line="    ${(l:$width:):-#$num}  ${colour[$key]}${(r:16:)key}${reset}  $title"
    (( $#labels )) && line+="  ${dim}(${(j:, :)labels})${reset}"
    out+=$line
    entries+="$num:$title"
  done <<< $issues

  mkdir -p ${index:h}
  print -l -- "github:$gh_repo" $entries >| $index
  (( $#out )) || { print "no ${${state:#all}:+open }issues in $gh_repo"; exit 0 }
  print -l -- "${bold}$gh_repo${reset}  ${dim}GitHub issues${reset}" "${out[@]}"
  summarise
  exit 0
fi

typeset -A counts
shown=0
projects=()
out=()
for project in .scratch/*(N/); do
  scan $project
  lines=()
  for (( i = 1; i <= $#issue_files; i++ )); do
    key=$issue_key[i]
    (( show_all )) || (( ! ${closed[(Ie)$key]} )) || continue
    counts[$key]=$(( ${counts[$key]:-0} + 1 ))
    line="       ${${issue_files[i]:t}%%-*}  ${colour[$key]}${(r:16:)issue_status[i]}${reset}  ${issue_title[i]}"
    [[ -n $issue_blockers[i] ]] && line+="  ${dim}(blocked by $issue_blockers[i])${reset}"
    lines+=$line
  done

  (( $#lines )) || continue
  (( shown++ )) && out+=('')
  projects+=${project:a}
  header="${(l:5:):-[$#projects]}  ${bold}${project:t}${reset}"
  if [[ -f $project/spec.md ]]; then
    spec_status=$(field Status $project/spec.md)
    header+="  ${dim}spec${spec_status:+: ${spec_status}}${reset}"
  else
    header+="  ${dim}no spec${reset}"
  fi
  out+=($header $lines)
done

# Save before printing, so a reader that stops early (`| head`) can't leave a stale index.
mkdir -p ${index:h}
print -l -- $projects >| $index
(( $#out )) && print -l -- "${out[@]}"

if (( ! shown )); then
  print "no open issues in .scratch"
  exit 0
fi

summarise
