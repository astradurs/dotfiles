#!/bin/bash

# Install jevgrep (the jg CLI) at a pinned version, off in every project until bin/jev-optin
# turns it on. Idempotent — safe to re-run, and re-running after a pin change upgrades.
#
# It saves your TypeSafe key for jg (TYPESAFE_API_KEY), and a separate work key if
# TYPESAFE_API_KEY_WORK is set; a project picks one with jev-optin.
# jg sends data only to api.typesafe.ai; this script fails if it is set up to use anything else.
# It also removes jev-pruner, which an earlier version of this script installed. See docs/jev.md.

set -eo pipefail

DOTFILES_DIR="$HOME/dotfiles"

JG_VERSION="0.8.5"
JG_INTEGRITY="sha512-SpJJzBpA8Tzf0u36CnPl8/qUfs9caqDNgDIsLnNkVJvDnOvWlE5FEUE8RDJxV/9DxY3DQnhC3VtALdJHapR1kQ=="
JG_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/jevgrep"
JG_BIN="$JG_PREFIX/node_modules/@dzhng/jevgrep/dist/bin/index.js"
# The work key gets its own jg config, so its credentials never mix with the personal one.
JG_WORK_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/jevgrep-work"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

PENDING=()

info()  { echo -e "${BOLD}==> $1${RESET}"; }
ok()    { echo -e "  ${GREEN}✓ $1${RESET}"; }
skip()  { echo -e "  ${YELLOW}⊘ $1${RESET}"; }
fail()  { echo -e "  ${RED}✗ $1${RESET}"; }
die()   { fail "$1"; exit 1; }

# --------------------------------------------------------------------------
# 1. jev-pruner (evaluated and dropped; see docs/jev.md)
# --------------------------------------------------------------------------
remove_pruner() {
    info "jev-pruner (removing: it pruned nothing in the benchmark)"

    command -v claude &>/dev/null || die "claude not found"

    # One entry per scope; a project that enabled it has a "local" entry of its own, which
    # only uninstalls from inside that project.
    local entries
    entries=$(python3 -I -c 'import json, os
d = json.load(open(os.path.expanduser("~/.claude/plugins/installed_plugins.json")))
for k, v in d.get("plugins", d).items():
    if k.startswith("fast-jev-output@"):
        for e in v:
            print(k, e.get("scope", "user"), e.get("projectPath", "-"), sep="\t")')

    if [[ -z "$entries" ]]; then
        skip "Not installed"
    else
        local plugin scope dir
        while IFS=$'\t' read -r plugin scope dir; do
            if [[ "$scope" == user ]]; then
                claude plugin uninstall "$plugin" --scope user >/dev/null
            elif [[ -d "$dir" ]]; then
                (cd "$dir" && claude plugin uninstall "$plugin" --scope "$scope" >/dev/null)
            fi
        done <<< "$entries"
        ok "Uninstalled"
    fi

    if claude plugin marketplace list 2>/dev/null | grep -q dotfiles-jev; then
        claude plugin marketplace remove dotfiles-jev >/dev/null
        ok "Removed the dotfiles-jev marketplace"
    fi

    # Uninstalling can leave the user-scope switch and options behind.
    python3 -I - <<'PY2' || die "jev-pruner is still installed somewhere (see above)"
import json, os, sys
home = os.path.expanduser("~/.claude")
path = f"{home}/settings.json"
s = json.load(open(path))
changed = False
for key in ("enabledPlugins", "pluginConfigs"):
    for k in [k for k in s.get(key, {}) if k.startswith("fast-jev-output@")]:
        del s[key][k]
        changed = True
if changed:
    with open(path, "w") as f:
        json.dump(s, f, indent=2)
        f.write("\n")
d = json.load(open(f"{home}/plugins/installed_plugins.json"))
left = [k for k in d.get("plugins", d) if k.startswith("fast-jev-output@")]
for k in left:
    print(f"  \033[0;31m✗ {k} is still installed (a project that was moved or deleted?)\033[0m")
sys.exit(1 if left else 0)
PY2
    ok "No jev-pruner left in Claude Code"
}

# --------------------------------------------------------------------------
# 2. jevgrep
# --------------------------------------------------------------------------
setup_jevgrep() {
    info "jevgrep ($JG_VERSION)"

    command -v npm &>/dev/null || die "npm not found"

    local current
    current=$(node "$JG_BIN" --version 2>/dev/null || true)
    if [[ "$current" == "$JG_VERSION" ]]; then
        skip "Already installed in $JG_PREFIX"
    else
        local tmp tarball integrity
        tmp=$(mktemp -d)
        (cd "$tmp" && npm pack "@dzhng/jevgrep@$JG_VERSION" --silent >/dev/null)
        tarball="$tmp/dzhng-jevgrep-$JG_VERSION.tgz"
        integrity="sha512-$(openssl dgst -sha512 -binary "$tarball" | base64)"
        [[ "$integrity" == "$JG_INTEGRITY" ]] || die "tarball checksum mismatch: $integrity"

        # Keep the verified tarball beside the install, since package.json refers to it.
        rm -rf "$JG_PREFIX"
        mkdir -p "$JG_PREFIX"
        mv "$tarball" "$JG_PREFIX/"
        rm -rf "$tmp"
        tarball="$JG_PREFIX/${tarball##*/}"
        npm install --prefix "$JG_PREFIX" --ignore-scripts --no-audit --no-fund --silent "$tarball"
        ok "Installed in $JG_PREFIX (checksum verified, install scripts off)"
    fi

    # A jg anywhere else on PATH (e.g. npm install -g) would skip the opt-in wrapper.
    local found
    found=$(type -ap jg | grep -v "^$HOME/bin/jg$" || true)
    [[ -z "$found" ]] || die "another jg on PATH bypasses ~/bin/jg: $found"
    [[ -n "$(type -ap jg)" ]] || PENDING+=("~/bin/jg is missing: run 'stow .' in $DOTFILES_DIR")

    setup_key personal TYPESAFE_API_KEY "${XDG_CONFIG_HOME:-$HOME/.config}"
    setup_key work TYPESAFE_API_KEY_WORK "$JG_WORK_CONFIG"
}

# Save one TypeSafe key for jg and check it: setup_key <name> <variable> <config home>.
# jg reads its key from <config home>/jevgrep/credentials.json only, never the environment,
# so ~/bin/jg picks a key by pointing XDG_CONFIG_HOME at the project's key (see bin/jg).
setup_key() {
    local name="$1" var="$2" creds="$3/jevgrep/credentials.json"
    local key="${!var}"

    if [[ -z "$key" ]]; then
        if [[ "$name" == personal ]]; then
            fail "$var is not set; skipping the $name key"
            PENDING+=("Add 'export $var=...' to ~/.secrets, open a new shell and re-run jev-install")
        else
            skip "$var is not set; no $name key (projects set to it won't search)"
        fi
        return
    fi

    if KEY="$key" python3 -I - "$creds" <<'PY2'
import json, os, sys
try:
    c = json.load(open(sys.argv[1]))
except FileNotFoundError:
    sys.exit(1)
sys.exit(0 if c.get("provider") == "typesafe" and c.get("apiKey") == os.environ["KEY"] else 1)
PY2
    then
        skip "The $name key is already saved"
    else
        printf '%s' "$key" | XDG_CONFIG_HOME="$3" node "$JG_BIN" auth --provider typesafe --stdin >/dev/null
        ok "Saved the $name key"
    fi

    python3 -I - "$creds" <<'PY2' || die "$name key check failed (see above)"
import json, os, stat, sys
path = sys.argv[1]
c = json.load(open(path))
errors = []
if c.get("provider") != "typesafe":
    errors.append(f"provider is {c.get('provider', 'unset (means vercel)')!r}, must be 'typesafe'")
if {"baseURL", "model"} & c.keys():
    errors.append("a custom endpoint is configured")
if stat.S_IMODE(os.stat(path).st_mode) & 0o077:
    errors.append(f"{path} is readable by others")
for e in errors:
    print(f"  \033[0;31m✗ {e}\033[0m")
sys.exit(1 if errors else 0)
PY2
    ok "The $name key uses the TypeSafe provider only"
}

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------
echo ""
echo -e "${BOLD}jev install${RESET}"
echo ""

remove_pruner
setup_jevgrep

echo ""
if [[ ${#PENDING[@]} -gt 0 ]]; then
    echo -e "${YELLOW}Still to do:${RESET}"
    for item in "${PENDING[@]}"; do
        echo -e "  ${YELLOW}•${RESET} $item"
    done
    exit 1
fi
echo -e "${GREEN}Done.${RESET} Projects opt in and out with jev-optin (jev-optin status shows one)."
