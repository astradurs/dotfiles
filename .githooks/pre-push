#!/bin/bash
# Re-runs the secrets and personal-data checks on every commit about to be pushed, which catches
# commits made with --no-verify or before the hooks were installed. See docs/guardrails.md.
# GitHub secret scanning with push protection is the last line of defence after this.

. "$(git rev-parse --show-toplevel)/.githooks/lib.sh"
require_gitleaks || exit 1

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a remote branch
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes" # new branch: only commits no remote has yet
    else
        range="$remote_sha..$local_sha"
    fi
    [ -z "$(git rev-list $range)" ] && continue

    echo "Checking commits for $remote_ref..." >&2
    if gitleaks git --log-opts="$range" --redact --verbose --no-banner --log-level warn .; then
        ok "no secrets (gitleaks)"
    else
        fail "gitleaks found secrets in commits being pushed (see above)"
        status=1
    fi
    git log -p -U0 --no-color --format= $range | scan_personal || status=1
done

if [ $status -ne 0 ]; then
    echo "Push blocked. Rewrite the offending commits (git rebase -i) before pushing." >&2
fi
exit $status
