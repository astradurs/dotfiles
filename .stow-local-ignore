# Files stow must not link into ~. This file replaces stow's built-in ignore list, so the
# defaults are repeated here (from Stow.pm, stow 2.4).
RCS
.+,v
CVS
\.\#.+
\.cvsignore
\.svn
_darcs
\.hg
\.git
\.gitignore
\.gitmodules
.+~
\#.*\#
^/README.*
^/LICENSE.*
^/COPYING

# Finder metadata (also in .gitignore); ~ has its own, so stowing one would conflict
\.DS_Store

# jev-optin's files when this repo itself is opted in; linked into ~/.claude they would turn
# jevgrep on for every session (see docs/jev.md)
^/\.claude/jevgrep-exclude
^/\.claude/skills/jevgrep

# Repo-only files
^/\.stow-local-ignore
^/\.githooks
^/jev
