# Machine-local drop-ins (live outside the repo; ignored here in case one is created by mistake).
# See docs/local-overrides.md.
*.local
.config/herdr/profiles.local/
.config/daily-report/
.secrets

# Ignore sensitive data
.ssh/
.gnupg/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Editor files
*.swp
*.swo
*~

# Credentials and secrets
*_history
.env
.env.local
credentials.json

# GitHub CLI authentication (contains OAuth tokens)
.config/gh/hosts.yml

# Atuin shell history database
.config/atuin/*.db
.config/atuin/*.db-*

# Other sensitive configs
.config/spotify-player/cache/

# Brewfile lock (machine-specific)
Brewfile.lock.json

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Taskwarrior data (local only)
.task/

# Planning docs (local only)
.planning/

# bin/ is an allowlist. ~/bin must stay a real directory so stow links each
# script individually; if it is ever deleted, stow re-folds ~/bin into a single
# symlink to this dir and anything writing to ~/bin (CrossOver game shortcuts,
# installers) lands in the repo. These rules keep that out of git.
# Adding a new script? Add a matching ! line or it will be silently untracked.
bin/*
!bin/asana-agenda
!bin/daily-report
!bin/dotfiles-bootstrap
!bin/herdr-up
!bin/node-kill
!bin/node-ps
!bin/scratch-issues
!bin/task-sync-asana
